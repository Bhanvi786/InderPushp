PORT=5001
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/inderpushp_db
JWT_SECRET=inderpushp_jwt_secret_dev_key_2025_secure

# ImageKit Configuration (Primary Media Provider)
# Obtain these from your ImageKit Dashboard (https://imagekit.io/dashboard/developer/api-keys)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Cloudinary Configuration (Optional Fallback)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Studio Admin Authentication
ADMIN_PASSWORD=your_admin_password
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash
